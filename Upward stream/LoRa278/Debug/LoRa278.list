void LoRa_SetPreambleLength(long length) {
    LoRa_WriteReg(REG_PREAMBLE_MSB, (length >> 8) & 0xFF);
    LoRa_WriteReg(REG_PREAMBLE_LSB, length & 0xFF);
}

